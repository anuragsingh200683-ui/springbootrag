# Copy to .env.local to override defaults
REACT_APP_API_BASE_URL=http://localhost:8090

# Keycloak auth server (see springboot-service/keycloak/README.md). Login happens on
# Keycloak's own page - no API credentials are configured in this app anymore.
REACT_APP_KEYCLOAK_URL=http://localhost:8180
REACT_APP_KEYCLOAK_REALM=aiapp
REACT_APP_KEYCLOAK_CLIENT_ID=aiapp-web
