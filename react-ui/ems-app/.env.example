# Copy to .env.local to override defaults

# springboot-service URL the Vite dev proxy forwards /api/** to.
VITE_API_PROXY_TARGET=http://localhost:8090

# Keycloak auth server (see springboot-service/keycloak/README.md).
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=aiapp
VITE_KEYCLOAK_CLIENT_ID=aiapp-web
