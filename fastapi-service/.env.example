# Copy this file to .env and fill in real values. Never commit the real .env.

# PostgreSQL connection (must match springboot-service/application.yml)
DATABASE_URL=postgresql+psycopg2://ai_app_user:ai_app_password@localhost:5432/ai_docs_db

# Which LLM provider to use: "anthropic" (Claude) or "openai"
LLM_PROVIDER=openai

# Claude API key (only needed if LLM_PROVIDER=anthropic) - https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# OpenAI API key (only needed if LLM_PROVIDER=openai) - https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# Embedding model (runs locally, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Semantic search
TOP_K_RESULTS=4

# Where Spring Boot saves uploaded PDFs (shared local folder on same machine)
UPLOAD_DIR=./uploaded_files

# Logging
LOG_LEVEL=INFO

# LangGraph orchestration for /api/qa/query (classifier -> rag/database/
# rest_api/tool/general -> answer generator). All LangGraph nodes are
# OpenAI-only, so OPENAI_API_KEY above must be set when this is true,
# regardless of LLM_PROVIDER. Set to false to instantly revert to the
# pre-LangGraph direct chain (respects LLM_PROVIDER, Anthropic or OpenAI).
USE_LANGGRAPH=true
