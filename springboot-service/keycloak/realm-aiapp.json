{
  "realm": "aiapp",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      { "name": "USER", "description": "Signed-in user: read APIs, document upload, Q&A, attendance, leave requests" },
      { "name": "ADMIN", "description": "Administrator: EMS master-data writes, leave approval, document deletion" }
    ]
  },
  "clients": [
    {
      "clientId": "aiapp-api",
      "name": "AI App API (resource server)",
      "description": "Audience for tokens accepted by springboot-service. Nobody logs in through this client.",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "aiapp-web",
      "name": "AI App web clients",
      "description": "Public client for react-ui / ems-app (Auth Code + PKCE) and for curl/Postman testing (password grant).",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:3000/*", "http://localhost:5173/*"],
      "webOrigins": ["http://localhost:3000", "http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##http://localhost:5173/*"
      },
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "aiapp-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "aiapp-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "user1",
      "email": "user1@example.local",
      "firstName": "Demo",
      "lastName": "User",
      "emailVerified": true,
      "enabled": true,
      "credentials": [{ "type": "password", "value": "user1pass", "temporary": false }],
      "realmRoles": ["USER"]
    },
    {
      "username": "admin1",
      "email": "admin1@example.local",
      "firstName": "Demo",
      "lastName": "Admin",
      "emailVerified": true,
      "enabled": true,
      "credentials": [{ "type": "password", "value": "admin1pass", "temporary": false }],
      "realmRoles": ["USER", "ADMIN"]
    }
  ]
}
